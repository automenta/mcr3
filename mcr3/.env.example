# Server Configuration
PORT=8080

# LLM Provider Configuration
# The provider to use ('openai', 'gemini', 'ollama', etc.)
MCR_LLM_PROVIDER="ollama"

# --- Provider API Keys ---
# Add your API key for the selected provider below.
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="..."

# --- Ollama Configuration (if used) ---
# The base URL for the Ollama server
OLLAMA_BASE_URL="http://localhost:11434"
